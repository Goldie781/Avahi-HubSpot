+      const overCta = cr.top < vh * .8 && cr.bottom > vh * .2;
+      fab.classList.toggle('is-shown', y > vh * .9 && fr.top > vh && !overCta);
+    }
+  }
+  addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(onScroll); } }, { passive: true });
+
+  let rz = 0;
+  addEventListener('resize', () => {
+    clearTimeout(rz);
+    rz = setTimeout(() => {
+      vw = innerWidth; vh = innerHeight;
+      if (net) net.resize();
+      extraNets.forEach(n => n.resize());
+      if (warp) warp.resize();
+      buildMarquees();
+      sizeIll();
+      lastCut = ''; svcEnter();
+      if (router) router.build();
+      drawWire(false);
+      if (!MQ_DESK_NAV.matches) moveGlider(null);
+      onScroll();
+    }, 120);
+  });
+  MQ_PIN.addEventListener ? MQ_PIN.addEventListener('change', svcMode) : MQ_PIN.addListener(svcMode);
+  if (document.fonts && document.fonts.ready) document.fonts.ready.then(() => { sizeIll(); if (router) router.build(); drawWire(false); });
+  addEventListener('load', () => { if (router) router.build(); drawWire(false); lastCut = ''; svcEnter(); });
+
+  svcMode();
+  onScroll();
+})();
+
+</script>
+</body>
+</html>
