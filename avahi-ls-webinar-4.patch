+const P=window.__pl, S=window.__src, out={};
+const SEV='{% elif key == "severity" %}';
+for(const m of ['results','timeline']){
+  let h=S[m+'/module.html']; if(h.includes('key == "structure"')) throw 'already patched '+m;
+  if(h.split(SEV).length!==2) throw 'anchor '+m;
+  out[m+'/module.html']=h.replace(SEV,P.branch+SEV);
+  const f=JSON.parse(S[m+'/fields.json']); let n=0;
+  (function walk(a){a.forEach(x=>{if(x.name==='icon'&&x.type==='choice'){const i=x.choices.findIndex(c=>c[0]==='none');x.choices.splice(i<0?x.choices.length:i,0,...P.choices);n++} if(x.children)walk(x.children)})})(f);
+  if(!n) throw 'no icon field '+m;
+  out[m+'/fields.json']=JSON.stringify(f,null,2);
+}
+{ let h=S['hero/module.html']; const a='{% else %}<div class="ill"><svg viewBox="0 0 640 360"';
+  if(h.split(a).length!==2) throw 'hero anchor';
+  out['hero/module.html']=h.replace(a,'{% elif v.poster_scene == "author" %}<div class="ill">'+P.hero_scene+'</div>'+a);
+  const f=JSON.parse(S['hero/fields.json']); const vg=f.find(x=>x.name==='video'); const i=vg.children.findIndex(c=>c.name==='poster');
+  vg.children.splice(i+1,0,{"id":"video.poster_scene","name":"poster_scene","label":"Illustration (shown when no poster image is set)","help_text":"Used only while the Poster image is empty. Pick the scene that matches the session.","required":false,"locked":false,"display":"select","choices":[["review","Batch record review (Session 02)"],["author","Source documents to drafted section (Session 04)"]],"multiple":false,"reordering_enabled":true,"preset":null,"type":"choice","display_width":null,"default":"review"});
+  out['hero/fields.json']=JSON.stringify(f,null,2); }
+{ let h=S['dark_panel/module.html']; const c='{% if module.scene == "trace" %}{% require_css %}';
+  if(h.split(c).length!==2) throw 'css anchor';
+  h=h.replace(c,'{% if module.scene == "trace" or module.scene == "author" %}{% require_css %}');
+  const a='{% elif module.scene == "trace" %}'; if(h.split(a).length!==2) throw 'trace anchor';
+  h=h.replace(a,'{% elif module.scene == "author" %}<div class="ill">'+P.dark_scene+'</div>'+a);
+  out['dark_panel/module.html']=h;
+  const f=JSON.parse(S['dark_panel/fields.json']); const sc=f.find(x=>x.name==='scene'); const ti=sc.choices.findIndex(x=>x[0]==='trace');
+  sc.choices.splice(ti+1,0,['author','Source documents to approved section scene (Session 04)']);
+  out['dark_panel/fields.json']=JSON.stringify(f,null,2); }
+window.__new=out;
+Object.entries(out).map(([k,v])=>k+' '+S[k].length+'->'+v.length).join(' | ')
