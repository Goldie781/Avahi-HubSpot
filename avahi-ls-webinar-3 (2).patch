+.lp-draw{stroke-dasharray:100 200;animation:lp-draw var(--lp,4.8s) cubic-bezier(.16,1,.3,1) infinite both;animation-delay:var(--d,0s)}
+@keyframes lp-draw{0%{stroke-dashoffset:101;opacity:1}32%,84%{stroke-dashoffset:0;opacity:1}96%,100%{stroke-dashoffset:0;opacity:0}}
