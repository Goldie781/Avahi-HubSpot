+      heroInner.style.transform = `translate3d(0,${(y * .16).toFixed(1)}px,0)`;
+      heroInner.style.opacity = (1 - k * 1.1).toFixed(3);
+      if (heroVideo) heroVideo.style.setProperty('--hs', (1 + k * .08).toFixed(4));
+    }
+    if (heroVideo && !RM.matches) { if (y > vh * 1.2) pause(heroVideo); else if (heroVideo.paused) play(heroVideo); }
+
+    svcEnter();
+    timelineProgress();
+    svcProgress();
+    mobileUpdate();
+    quoteProgress();
+    rapidProgress();
+
+    // floating CTA: after the first screen, hidden over the CTA panel and footer
+    if (fab) {
+      const fr = foot ? foot.getBoundingClientRect() : { top: Infinity };
+      const cr = cta ? cta.getBoundingClientRect() : { top: Infinity, bottom: -Infinity };
+      const overCta = cr.top < vh * .8 && cr.bottom > vh * .2;
+      fab.classList.toggle('is-shown', y > vh * .9 && fr.top > vh && !overCta);
+    }
+  }
+  addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(onScroll); } }, { passive: true });
+
+  let rz = 0;
+  addEventListener('resize', () => {
+    clearTimeout(rz);
+    rz = setTimeout(() => {
+      vw = innerWidth; vh = innerHeight;
+      if (net) net.resize();
+      extraNets.forEach(n => n.resize());
+      if (warp) warp.resize();
+      buildMarquees();
+      sizeIll();
+      lastCut = ''; svcEnter();
+      if (router) router.build();
+      drawWire(false);
+      if (!MQ_DESK_NAV.matches) moveGlider(null);
+      onScroll();
+    }, 120);
+  });
+  MQ_PIN.addEventListener ? MQ_PIN.addEventListener('change', svcMode) : MQ_PIN.addListener(svcMode);
+  if (document.fonts && document.fonts.ready) document.fonts.ready.then(() => { sizeIll(); if (router) router.build(); drawWire(false); });
+  addEventListener('load', () => { if (router) router.build(); drawWire(false); lastCut = ''; svcEnter(); });
+
+  svcMode();
+  onScroll();
+})();
+
+</script>
+</body>
+</html>
